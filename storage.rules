// Tagda Timer — Firebase Storage rules
//
// One path exists on purpose: avatars/<uid>, one file per account, owner-
// write, public-read. Public read because it's just a profile photo shown
// next to a username in a room's player list — no different in sensitivity
// from the name itself, which already has no read restriction. Everything
// else is denied by the catch-all at the bottom, same "explicit allow,
// deny by default" shape as firebase.rules.json.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid} {
      allow read: if true;
      // The client always re-encodes through canvas.toBlob as JPEG before
      // upload (see resizeImageToSquare in js/sync-ui.js), so the rule can
      // require exactly that rather than the broader 'image/.*' — which
      // would also admit image/svg+xml, and SVG can carry a <script>.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
