{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "solves": {
          "$id": {
            ".validate": "newData.hasChildren(['id', 'createdAt']) && newData.child('id').val() === $id",
            "id":           { ".validate": "newData.isString() && newData.val().length <= 64" },
            "sessionId":    { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
            "event":        { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 24)" },
            "mode":         { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 24)" },
            "scramble":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000)" },
            "caseId":       { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
            "caseName":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" },
            "cubeId":       { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
            "timeMs":       { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 36000000)" },
            "penalty":      { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 16)" },
            "inspectionMs": { ".validate": "!newData.exists() || newData.isNumber()" },
            "comment":      { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 4000)" },
            "createdAt":    { ".validate": "newData.isNumber()" },
            "race":         { ".validate": "!newData.exists() || newData.isBoolean()" },
            "roomId":       { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 16)" },
            "bld":          { ".validate": true },
            "phases":       { ".validate": true },
            "recon":        { ".validate": true },
            "competitionSetId": { ".validate": "!newData.exists() || (newData.isString() && root.child('users').child($uid).child('competitionSets').child(newData.val()).child('status').val() !== 'discarded')" },
            "competitionAttempt": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0)" },
            "competitionTiming": { ".validate": true },
            "competitionRecordedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "competitionStartedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "competitionInspectionAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "penaltyUpdatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "$other":       { ".validate": false }
          }
        },

        "sessions": {
          "$id": {
            ".validate": "newData.hasChildren(['id', 'createdAt']) && newData.child('id').val() === $id",
            "id":        { ".validate": "newData.isString() && newData.val().length <= 64" },
            "name":      { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
            "event":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 24)" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "order":     { ".validate": "!newData.exists() || newData.isNumber()" },
            "race":      { ".validate": "!newData.exists() || newData.isBoolean()" },
            "virtual":   { ".validate": "!newData.exists() || newData.isBoolean()" },
            "goal": {
              ".validate": "newData.hasChildren(['value', 'stat'])",
              "value": { ".validate": "newData.isNumber() && newData.val() > 0" },
              "stat":  { ".validate": "newData.isString() && newData.val().matches(/^(single|ao5|ao12)$/)" },
              "hitAt": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },
            "$other":    { ".validate": false }
          }
        },

        "settings": {
          ".validate": "newData.hasChildren() || !newData.exists()",
          "avatar": { ".read": "auth != null && (!data.exists() || (data.isString() && data.val().length <= 40000))" }
        },
        "learn": { ".validate": "newData.hasChildren() || !newData.exists()" },

        "competitionSets": {
          "$id": {
            ".validate": "newData.hasChildren(['id', 'status', 'size', 'sessionId', 'event', 'createdAt']) && newData.child('id').val() === $id && newData.child('size').isNumber() && newData.child('size').val() >= 5 && newData.child('size').val() % 1 === 0 && (data.child('status').val() !== 'discarded' || newData.child('status').val() === 'discarded')"
          }
        },
        "gear":        { "$id":   { ".validate": "newData.hasChildren(['id']) && newData.child('id').val() === $id" } },
        "gearLog":     { "$id":   { ".validate": "newData.hasChildren(['id', 'gearId']) && newData.child('id').val() === $id" } },
        "letterPairs": { "$pair": { ".validate": "newData.hasChildren(['pair']) && newData.child('pair').val() === $pair" } },
        "kv":          { "$key":  { ".validate": "$key.beginsWith('alglib') || $key === 'xp1Settings' || $key === 'xp1History'" } },

        "$other": { ".validate": false }
      }
    },

    "rooms": {
      "$roomId": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null",
          "round": {
            ".validate": "!data.exists() || newData.val() === data.val() + 1"
          },
          "phase": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "$other": { ".validate": true }
        },

        "chat": {
          ".read": "auth != null",

          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at'])",
            "uid":  { ".validate": "newData.isString() && newData.val().length <= 64" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
            "at":   { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'joinedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "color": { ".validate": "newData.isNumber()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "rounds": {
          "$roundId": {
            "info": {
              ".read": "auth != null",
              ".write": "auth != null && !data.exists()",
              ".validate": "newData.hasChildren(['scramble', 'hash'])",
              "scramble": { ".validate": "newData.isString() && newData.val().length <= 600" },
              "hash": { ".validate": "newData.isString() && newData.val().length <= 16" },
              "event": { ".validate": "newData.isString() && newData.val().length <= 12" },
              "startedAt": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },

            "progress": {
              ".read": "auth != null",
              "$uid": {
                ".write": "auth != null && auth.uid === $uid",
                "status": { ".validate": "newData.isString() && newData.val().length <= 12" },
                "startedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 2000" },
                "finishedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 2000" },
                "$other": { ".validate": false }
              }
            },

            "results": {
              ".read": "auth != null && data.child(auth.uid).exists()",

              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists()",

                ".validate": "newData.hasChildren(['timeMs', 'hash']) && newData.child('hash').val() === root.child('rooms/' + $roomId + '/rounds/' + $roundId + '/info/hash').val() && (!root.child('rooms/' + $roomId + '/rounds/' + $roundId + '/progress/' + auth.uid + '/startedAt').exists() || !root.child('rooms/' + $roomId + '/rounds/' + $roundId + '/progress/' + auth.uid + '/finishedAt').exists() || newData.child('timeMs').val() >= (root.child('rooms/' + $roomId + '/rounds/' + $roundId + '/progress/' + auth.uid + '/finishedAt').val() - root.child('rooms/' + $roomId + '/rounds/' + $roundId + '/progress/' + auth.uid + '/startedAt').val()) * 0.75 - 4000)",

                "timeMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 36000000" },
                "penalty": { ".validate": "newData.isString() && newData.val().length <= 8" },
                "hash": { ".validate": "newData.isString() && newData.val().length <= 16" },
                "suspect": { ".validate": "newData.isBoolean() || !newData.exists()" },
                "submittedAt": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            }
          }
        }
      }
    },

    "daily": {
      "$dayStart": {
        ".validate": "$dayStart.matches(/^[0-9]{13}$/)",
        "$event": {
          "scramble": {
            ".read": true,
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val().length <= 600"
          },

          "backupClaim": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('daily/' + $dayStart + '/' + $event + '/progress/' + $uid).exists() && !root.child('daily/' + $dayStart + '/' + $event + '/results/' + $uid).exists()",
              ".validate": "newData.isNumber() && newData.val() <= now + 2000"
            }
          },

          "backup": {
            ".read": "auth != null && root.child('daily/' + $dayStart + '/' + $event + '/backupClaim/' + auth.uid).exists()",
            ".write": "auth != null && !data.exists() && root.child('daily/' + $dayStart + '/' + $event + '/backupClaim/' + auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().length <= 600"
          },

          "replayClaim": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && ((auth.uid === $uid && !data.exists() && root.child('daily/' + $dayStart + '/' + $event + '/results/' + $uid).exists()) || (auth.uid === '8lSr96LEO1cdHDVlMDv8tCCFQag1' && !newData.exists() && newData.parent().parent().child('removed/' + $uid + '/at').val() === now))",
              ".validate": "newData.isNumber() && newData.val() <= now + 2000"
            }
          },

          "removed": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === '8lSr96LEO1cdHDVlMDv8tCCFQag1' && newData.exists() && root.child('daily/' + $dayStart + '/' + $event + '/results/' + $uid).exists() && !newData.parent().parent().child('results/' + $uid).exists()",
              ".validate": "newData.hasChildren(['at', 'final'])",
              "at":     { ".validate": "newData.val() === now" },
              "final":  { ".validate": "newData.isBoolean() && newData.val() === root.child('daily/' + $dayStart + '/' + $event + '/backupClaim/' + $uid).exists()" },
              "$other": { ".validate": false }
            }
          },

          "progress": {
            ".read": true,
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              "status":     { ".validate": "newData.isString() && newData.val().length <= 12" },
              "startedAt":  { ".validate": "newData.isNumber() && newData.val() <= now + 2000" },
              "finishedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 2000" },
              "submitted":  { ".write": "auth != null && auth.uid === '8lSr96LEO1cdHDVlMDv8tCCFQag1' && !newData.exists() && newData.parent().parent().parent().child('removed/' + $uid + '/at').val() === now", ".validate": "newData.isBoolean()" },
              "$other":     { ".validate": false }
            }
          },

          "results": {
            ".read": "auth != null && data.child(auth.uid).exists()",

            "$uid": {
              ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || (auth.uid === '8lSr96LEO1cdHDVlMDv8tCCFQag1' && data.exists() && !newData.exists() && newData.parent().parent().child('removed/' + $uid + '/at').val() === now))",

              ".validate": "newData.hasChildren(['timeMs']) && (!root.child('daily/' + $dayStart + '/' + $event + '/backupClaim/' + $uid).exists() || newData.child('backup').val() === true) && (!root.child('daily/' + $dayStart + '/' + $event + '/removed/' + $uid).exists() || (root.child('daily/' + $dayStart + '/' + $event + '/removed/' + $uid + '/final').val() !== true && newData.child('backup').val() === true)) && (!root.child('daily/' + $dayStart + '/' + $event + '/progress/' + auth.uid + '/startedAt').exists() || !root.child('daily/' + $dayStart + '/' + $event + '/progress/' + auth.uid + '/finishedAt').exists() || newData.child('timeMs').val() >= (root.child('daily/' + $dayStart + '/' + $event + '/progress/' + auth.uid + '/finishedAt').val() - root.child('daily/' + $dayStart + '/' + $event + '/progress/' + auth.uid + '/startedAt').val()) * 0.75 - 4000)",

              "timeMs":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 36000000" },
              "penalty":     { ".validate": "newData.isString() && newData.val().length <= 8" },
              "name":        { ".validate": "newData.isString() && newData.val().length <= 32" },
              "note":        { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isString() && newData.val().length <= 80" },
              "photo":       { ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().matches(/^https:[/][/]lh[0-9]+[.]googleusercontent[.]com[/]/)" },
              "suspect":     { ".validate": "newData.isBoolean() || !newData.exists()" },
              "backup":      { ".validate": "newData.val() === true && root.child('daily/' + $dayStart + '/' + $event + '/backupClaim/' + $uid).exists()" },
              "replay":      { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isBoolean() && (newData.val() === false || root.child('daily/' + $dayStart + '/' + $event + '/replayClaim/' + $uid).exists())" },
              "submittedAt": { ".validate": "newData.isNumber()" },
              "$other":      { ".validate": false }
            }
          },

          "chat": {
            ".read": "auth != null && root.child('daily/' + $dayStart + '/' + $event + '/results/' + auth.uid).exists()",
            ".write": "auth != null && !newData.exists() && $dayStart !== '' + (now - ((now + 19800000) % 86400000))",

            "m": {
              "$msgId": {
                ".write": "auth != null && ((!data.exists() && newData.exists() && auth.token.firebase.sign_in_provider === 'google.com' && $dayStart === '' + (now - ((now + 19800000) % 86400000)) && root.child('daily/' + $dayStart + '/' + $event + '/results/' + auth.uid).exists()) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || auth.uid === '8lSr96LEO1cdHDVlMDv8tCCFQag1')))",
                ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at']) && newData.parent().parent().child('last/' + auth.uid).val() === now",
                "uid":    { ".validate": "newData.val() === auth.uid" },
                "name":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32" },
                "text":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
                "at":     { ".validate": "newData.val() === now" },
                "photo":  { ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().matches(/^https:[/][/]lh[0-9]+[.]googleusercontent[.]com[/]/)" },
                "$other": { ".validate": false }
              }
            },

            "last": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && newData.exists() && $dayStart === '' + (now - ((now + 19800000) % 86400000))",
                ".validate": "newData.val() === now && (!data.exists() || data.val() <= now - 1500)"
              }
            },

            "$other": { ".validate": false }
          }
        }
      }
    },

    "dailyCount": {
      "$dayStart": {
        ".read": true,
        ".validate": "$dayStart.matches(/^[0-9]{13}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || newData.child('n').val() >= data.child('n').val())",
          ".validate": "newData.hasChildren(['n'])",
          "n":     { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000" },
          "name":  { ".validate": "newData.isString() && newData.val().length <= 32" },
          "photo": { ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().matches(/^https:[/][/]lh[0-9]+[.]googleusercontent[.]com[/]/)" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
