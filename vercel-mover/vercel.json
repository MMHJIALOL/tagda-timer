{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://tagdatimer.me/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://tagdatimer.me/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
