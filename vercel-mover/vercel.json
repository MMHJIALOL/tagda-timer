{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://tagdatimer.me/",
      "permanent": true
    },
    {
      "source": "/:path((?!import-from-vercel$).+)",
      "destination": "https://tagdatimer.me/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/import-from-vercel", "destination": "/import-data.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
