# Files in the repo root that must not be served by the Cloudflare deploy
# (the asset directory is the whole repo). The worker's own source and config
# are bundled separately, and .git would otherwise be downloadable.
.git
.wrangler
node_modules
node_modules/**
package.json
package-lock.json
wrangler.jsonc
worker.js
# Same reason as .vercelignore: it writes to whoever's synced data is signed in.
sync-test.html
# The tagdatimer.vercel.app redirect page, deployed to Vercel on its own.
vercel-mover
# Local Worker vars (gitignored too, but never served even when present).
.dev.vars
# Hardware regression recordings stay in the source checkout.
tools/fixtures/smart-cube/gan-i4-*.json
tools/fixtures/smart-cube/gan-icarry4.json
tools/fixtures/smart-cube/gan-icarry4-raw.json

# Connection UI browser checks and screenshots are source-only.
docs/smart-cube-connection-*
tools/verify-smart-cube-connection-ui.cjs

# Interactive layout regression checks are source-only.
tools/verify-interactive-layout.cjs
js/layout-grid.check.mjs
audit-qa

# Lab routes are served by their own Worker; hardware evidence stays local.
tools/smart-cube-worker
tools/verify-gan-carry4-browser.mjs
tools/verify-gan-carry4-main.mjs
js/gan-carry4.check.mjs
