# The source model is 43 MB. GitHub warns past 50 MB and every clone and every
# deploy would carry it, so the rendered PNGs in assets/ are what ship. Keep the
# .obj locally; tools/render_logo.py regenerates the assets from it.
*.obj

# OS / editor noise
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Agent/editor workspace config
.claude/

# Wrangler's local state and its local vars (tools/sotd-replay-dev.mjs writes .dev.vars)
.wrangler/
.dev.vars

# Disposable Competition Mode browser verification screenshots
competition-qa/

# Local test dependencies
node_modules/
