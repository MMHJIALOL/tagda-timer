# Cloudflare's default for every asset is "public, max-age=0, must-revalidate",
# which is what js/ and css/ need (no content hashes). Only the files that never
# change in place get longer caching, matching vercel.json.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
